<?xml version="1.0" encoding="UTF-8"?>
<!-- DiamaneOS: the projects DiamaneOS adds to GrapheneOS's manifest or takes from its own
     forks. default.xml is GrapheneOS's file with one include of this file at its end. -->
<manifest>

  <!-- DiamaneOS overlay (forks, own projects and pinned upstream sources). -->
  <remote name="diamaneos" fetch="https://github.com/DiamaneOS/" revision="android17" />
  <!-- Upstreams of repositories used unmodified, pinned to exact commits. -->
  <remote name="codelinaro" fetch="https://git.codelinaro.org/clo/la/" />
  <remote name="codelinaro-le" fetch="https://git.codelinaro.org/clo/le/" />
  <remote name="fairphone" fetch="https://gerrit-public.fairphone.software/" />
  <remote name="linux-msm" fetch="https://github.com/linux-msm/" />

  <!-- GrapheneOS and AOSP projects DiamaneOS replaces with its forks, GrapheneOS's boot animation
       (vendor_diamaneos installs its own bootanimation_zip), GrapheneOS's App Store, Auditor and
       Camera prebuilts (vendor_diamaneos apps/ holds ours) and the kernels of other devices. -->
  <remove-project name="branding" />
  <remove-project name="platform_bootable_recovery" />
  <remove-project name="platform_build" />
  <remove-project name="device/amlogic/yukawa-kernel" />
  <remove-project name="device_google_akita-kernels_6.1" />
  <remove-project name="device_google_bluejay-kernels_6.1" />
  <remove-project name="device_google_caimito-kernels_6.1" />

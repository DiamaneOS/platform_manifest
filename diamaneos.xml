<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal DiamaneOS local-manifest overlay.

  The authenticated GrapheneOS release tag supplies the upstream project map.
  DiamaneOS forks (remote diamaneos) exist only where we change the code.
  Repositories used unmodified come straight from their upstream at the
  pinned commit. Upstreams and tracked references: tools config/forks.json.
  Freeze resolved commits in the build environment and release manifest.
-->
<manifest>
  <remote name="diamaneos"
          fetch="https://github.com/DiamaneOS/" revision="android17" />
  <!-- Upstreams of repositories used unmodified, pinned to exact commits. -->
  <remote name="codelinaro"
          fetch="https://git.codelinaro.org/clo/la/" />
  <remote name="codelinaro-le"
          fetch="https://git.codelinaro.org/clo/le/" />
  <remote name="fairphone"
          fetch="https://gerrit-public.fairphone.software/" />
  <project name="device_fairphone_FP6" path="device/fairphone/FP6"
           remote="diamaneos" />
  <project name="vendor_diamaneos" path="vendor/diamaneos"
           remote="diamaneos" />
  <!-- Isolated IMS data broker; the stock IMS and IWLAN frontends remain in
       the authenticated vendor selection. AML is not selected. -->
  <project name="hardware_diamaneos_ims" path="hardware/diamaneos/ims"
           remote="diamaneos" />
  <!-- Maintained carrier service with optional device configuration data. -->
  <remove-project name="platform/packages/apps/CarrierConfig" />
  <project name="platform_packages_apps_CarrierConfig" path="packages/apps/CarrierConfig"
           remote="diamaneos" />
  <!-- Preserve carrier HTTPS provisioning without the inherited Google push SDKs. -->
  <remove-project name="platform/packages/apps/ImsServiceEntitlement" />
  <project name="platform_packages_apps_ImsServiceEntitlement" path="packages/apps/ImsServiceEntitlement"
           remote="diamaneos" />
  <!-- Required published boot-control and GPT/UFS implementation. -->
  <project name="hardware_qcom_bootctrl" path="hardware/qcom/bootctrl"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_recovery-ext" path="vendor/qcom/opensource/recovery-ext"
           remote="diamaneos" />
  <!-- Source HALs used by the minimal FP6 product. -->
  <project name="vendor_qcom_opensource_power" path="vendor/qcom/opensource/power"
           remote="diamaneos" />
  <!-- Qualcomm display stack built from source (CodeLinaro bases with reviewed patches). -->
  <project name="hardware_qcom_display" path="hardware/qcom/display"
           remote="diamaneos" />
  <project name="platform/vendor/qcom-opensource/display-commonsys-intf" path="vendor/qcom/opensource/commonsys-intf/display"
           remote="codelinaro" revision="0bd3aa234cb00ec16b5c6092e98ce622ae1e86eb" />
  <project name="platform/vendor/qcom-opensource/interfaces" path="vendor/qcom/opensource/interfaces"
           remote="codelinaro" revision="357f62518548d522e47bff78b825321bf8f15f00" />
  <project name="platform/system/memory/libvmmem" path="vendor/qcom/opensource/libvmmem"
           remote="codelinaro-le" revision="543447bf4b8197d58258729f155b91c750a0247e" />
  <!-- Telephony framework: batch the vendor RIL's network-state polls while idle. -->
  <remove-project name="platform_frameworks_opt_telephony" />
  <project name="platform_frameworks_opt_telephony" path="frameworks/opt/telephony"
           remote="diamaneos" groups="pdk,sysui-studio" />
  <!-- Preserve address-state changes through framework callback comparisons. -->
  <remove-project name="platform_packages_modules_Connectivity" />
  <project name="platform_packages_modules_Connectivity" path="packages/modules/Connectivity"
           remote="diamaneos" groups="pdk-cw-fs,pdk-fs" />
  <!-- Keep the device's boot header arguments when release tools rebuild images. -->
  <remove-project name="platform_build" />
  <project name="platform_build" path="build/make"
           remote="diamaneos" groups="pdk,sysui-studio">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk"/>
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default"/>
    <linkfile src="core" dest="build/core"/>
    <linkfile src="envsetup.sh" dest="build/envsetup.sh"/>
    <linkfile src="target" dest="build/target"/>
    <linkfile src="tools" dest="build/tools"/>
  </project>
  <!-- Qualcomm Wi-Fi HAL from CodeLinaro (Soong-converted) replaces AOSP's copy. -->
  <remove-project name="platform/hardware/qcom/wlan" />
  <project name="hardware_qcom_wlan" path="hardware/qcom/wlan"
           remote="diamaneos" />
  <project name="platform/hardware/qcom/thermal" path="vendor/qcom/opensource/thermal-hal"
           remote="fairphone" revision="3ccdfb5200c578ce349bcd985e1f95a241bc50d5" />
  <project name="platform/vendor/qcom-opensource/lights" path="vendor/qcom/opensource/lights"
           remote="codelinaro" revision="a5d6338d75992bc6ad748459638e558835848da3" />
  <project name="vendor_qcom_opensource_vibrator" path="vendor/qcom/opensource/vibrator"
           remote="diamaneos" />
  <project name="platform/vendor/qcom-opensource/usb" path="vendor/qcom/opensource/usb"
           remote="fairphone" revision="7e65693c12f98c3aca9721287dc2c648ea83e65a" />
  <project name="platform/vendor/qcom-opensource/healthd-ext" path="vendor/qcom/opensource/healthd-ext"
           remote="codelinaro" revision="d8f830f18bbdcf12c3f7d656d77a16beeaed946a" />
  <!-- Tally and Pleat: the DiamaneOS forks replace GrapheneOS's projects. Their android17 branches
       carry the Tally work since 29 September 2026 (owner's decision, before its phone test; updated 30 September and 1 October).
       Roadmap: diamaneos-private reviews/OP-APPS-FORKS-2026-09-26/IMPLEMENTATION-ROADMAP.md. -->
  <!-- SystemUI shell, WM Shell motion, SettingsLib switches, system label, fallback boot logo (steps 3 and 5) -->
  <remove-project name="platform_frameworks_base" />
  <project name="platform_frameworks_base" path="frameworks/base"
           remote="diamaneos" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <!-- DiamaneOS palette style in monet (step 2) -->
  <remove-project name="platform_frameworks_libs_systemui" />
  <project name="platform_frameworks_libs_systemui" path="frameworks/libs/systemui"
           remote="diamaneos" groups="pdk-cw-fs,pdk-fs,sysui-studio" />
  <!-- Wallpaper & style previews that match the applied palette (step 2) -->
  <remove-project name="platform_packages_apps_ThemePicker" />
  <project name="platform_packages_apps_ThemePicker" path="packages/apps/ThemePicker"
           remote="diamaneos" groups="pdk-fs,sysui-studio" />
  <!-- Wallpaper previews that follow the contrast setting (step 2) -->
  <remove-project name="platform_packages_apps_WallpaperPicker2" />
  <project name="platform_packages_apps_WallpaperPicker2" path="packages/apps/WallpaperPicker2"
           remote="diamaneos" groups="pdk-fs,sysui-studio" />
  <!-- Home, All apps and Recents (step 4) -->
  <remove-project name="platform_packages_apps_Launcher3" />
  <project name="platform_packages_apps_Launcher3" path="packages/apps/Launcher3"
           remote="diamaneos" groups="pdk-cw-tvc,pdk-fs,sysui-studio" />
  <!-- Search at the bottom, state lamps, hierarchy (step 6) -->
  <remove-project name="platform_packages_apps_Settings" />
  <project name="platform_packages_apps_Settings" path="packages/apps/Settings"
           remote="diamaneos" groups="pdk-cw-tvc,pdk-fs,sysui-studio" />
  <!-- Settings search slot (step 6) -->
  <remove-project name="platform_packages_apps_SettingsIntelligence" />
  <project name="platform_packages_apps_SettingsIntelligence" path="packages/apps/SettingsIntelligence"
           remote="diamaneos" groups="pdk-fs" />
  <!-- Material 3 Clock (step 7) -->
  <remove-project name="platform_packages_apps_DeskClock" />
  <project name="platform_packages_apps_DeskClock" path="packages/apps/DeskClock"
           remote="diamaneos" groups="pdk-fs" />
  <!-- Calculator AC key and smart brackets (step 7) -->
  <remove-project name="platform_packages_apps_ExactCalculator" />
  <project name="platform_packages_apps_ExactCalculator" path="packages/apps/ExactCalculator"
           remote="diamaneos" />
  <!-- Recovery and fastbootd titles (step 7) -->
  <remove-project name="platform_bootable_recovery" />
  <project name="platform_bootable_recovery" path="bootable/recovery"
           remote="diamaneos" groups="pdk" />
  <!-- Files: Get info takes the system palette like the other screens (UI test B-25) -->
  <remove-project name="platform_packages_apps_DocumentsUI" />
  <project name="platform_packages_apps_DocumentsUI" path="packages/apps/DocumentsUI"
           remote="diamaneos" groups="pdk-cw-fs,pdk-fs" />
  <!-- Keyboard privacy fixes (register -108; step 7) -->
  <remove-project name="platform_packages_inputmethods_LatinIME" />
  <project name="platform_packages_inputmethods_LatinIME" path="packages/inputmethods/LatinIME"
           remote="diamaneos" groups="pdk-fs" />
</manifest>

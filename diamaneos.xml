  <remove-project name="device_google_lynx-kernels_6.1" />
  <remove-project name="device_google_pantah-kernels_6.1" />
  <remove-project name="device_google_raviole-kernels_6.1" />
  <remove-project name="device_google_shusky-kernels_6.1" />
  <remove-project name="device_google_stallion-kernels_6.1" />
  <remove-project name="device_google_tangorpro-kernels_6.1" />
  <remove-project name="device_google_tegu-kernels_6.1" />
  <remove-project name="device/linaro/dragonboard-kernel" />
  <remove-project name="device/linaro/hikey-kernel" />
  <remove-project name="platform_external_AppStore" />
  <remove-project name="platform_external_Auditor" />
  <remove-project name="platform_external_Camera" />
  <remove-project name="platform_frameworks_av" />
  <remove-project name="platform_frameworks_base" />
  <remove-project name="platform_frameworks_libs_systemui" />
  <remove-project name="platform_frameworks_native" />
  <remove-project name="platform_frameworks_opt_telephony" />
  <remove-project name="platform/hardware/qcom/wlan" />
  <remove-project name="kernel/prebuilts/6.1/arm64" />
  <remove-project name="kernel/prebuilts/6.1/x86-64" />
  <remove-project name="kernel_prebuilts_6.18_arm64" />
  <remove-project name="kernel_prebuilts_6.18_x86-64" />
  <remove-project name="kernel/prebuilts/common-modules/trusty/6.6/arm64" />

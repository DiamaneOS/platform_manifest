<?xml version="1.0" encoding="UTF-8"?>
<!--
  Minimal DiamaneOS local-manifest overlay.

  The authenticated GrapheneOS release tag supplies the upstream project map.
  Every project here is a DiamaneOS fork on the development branch; upstream
  sources and tracked references are recorded in tools config/forks.json.
  Freeze resolved commits in the build environment and release manifest.
-->
<manifest>
  <remote name="diamaneos"
          fetch="https://github.com/DiamaneOS/" revision="android17" />
  <project name="device_fairphone_FP6" path="device/fairphone/FP6"
           remote="diamaneos" />
  <project name="vendor_diamaneos" path="vendor/diamaneos"
           remote="diamaneos" />
  <!-- Required published boot-control and GPT/UFS implementation. -->
  <project name="hardware_qcom_bootctrl" path="hardware/qcom/bootctrl"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_recovery-ext" path="vendor/qcom/opensource/recovery-ext"
           remote="diamaneos" />
  <!-- Source HALs used by the minimal FP6 product. -->
  <project name="vendor_qcom_opensource_power" path="vendor/qcom/opensource/power"
           remote="diamaneos" />
  <!-- Qualcomm display stack built from source (CodeLinaro bases with reviewed patches). -->
  <project name="hardware_qcom_display" path="hardware/qcom/display"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_display-commonsys-intf" path="vendor/qcom/opensource/commonsys-intf/display"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_interfaces" path="vendor/qcom/opensource/interfaces"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_libvmmem" path="vendor/qcom/opensource/libvmmem"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_thermal-hal" path="vendor/qcom/opensource/thermal-hal"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_lights" path="vendor/qcom/opensource/lights"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_vibrator" path="vendor/qcom/opensource/vibrator"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_usb" path="vendor/qcom/opensource/usb"
           remote="diamaneos" />
  <project name="vendor_qcom_opensource_healthd-ext" path="vendor/qcom/opensource/healthd-ext"
           remote="diamaneos" />
</manifest>
